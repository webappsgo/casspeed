FROM casjaysdev/go:latest AS builder

ARG TARGETARCH
ARG VERSION=devel
ARG BUILD_DATE
ARG BUILD_EPOCH=0
ARG COMMIT_ID=unknown
ARG OFFICIAL_SITE

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build \
    -ldflags "-X 'main.Version=${VERSION}' -X 'main.CommitID=${COMMIT_ID}' -X 'main.BuildEpoch=${BUILD_EPOCH}' -X 'main.OfficialSite=${OFFICIAL_SITE}'" \
    -o /app/binary/casspeed ./src

FROM alpine:latest

RUN apk add --no-cache git curl bash tini tor i2pd tzdata ca-certificates
COPY --from=builder /app/binary/casspeed /usr/local/bin/casspeed
COPY docker/rootfs/ /
COPY docker/Dockerfile.dev /root/Dockerfile

ENV MODE=development \
    TZ=America/New_York \
    DATABASE_DIR=/data/db/sqlite

EXPOSE 80
STOPSIGNAL SIGRTMIN+3
HEALTHCHECK --start-period=10m --interval=5m --timeout=15s --retries=3 CMD /usr/local/bin/casspeed --status || exit 1
ENTRYPOINT ["tini", "-p", "SIGTERM", "--", "/usr/local/bin/entrypoint.sh"]
